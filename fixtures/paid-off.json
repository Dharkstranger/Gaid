{"version":1,"slug":"paid-off","publishedAt":"2026-09-26T00:00:00.000Z","brand":{"name":"Test paid-off","tagline":"","logo":null,"accent":"#E2551F","ink":"#14120E","background":"#FBF9F0","surface":"#FFFFFF","display":"'Fraunces', Georgia, serif","body":"'Inter', system-ui, sans-serif"},"info":{"welcome":"Nine works from the permanent collection, with the story behind each one. Tap a piece, or find what is nearest to you.","hours":"Tuesday to Sunday, 10am – 6pm. Closed Mondays.","email":"hello@example.org","phone":"+234 000 000 0000","address":"1 Marina Road, Lagos Island, Lagos","about":"A sample collection, made to show how the Galleris app works. The artworks and the people are invented; the app is real."},"languages":["English","Yoruba","Igbo"],"fieldDefs":[{"id":"fd_support","label":"Support","hint":"e.g. Oil on canvas"}],"artists":[{"id":"ar1","name":"Adaeze Obi","bio":"Painter working in oil and found pigment, whose landscapes trace the lagoon edge her family has fished for four generations.","imageId":"a1"},{"id":"ar2","name":"Chinedu Mbah","bio":"Sculptor and carver. Trained under his grandfather and now teaches at the university, where he runs the bronze foundry.","imageId":"a4"},{"id":"ar3","name":"Halima Yusuf","bio":"Textile and print artist. Her geometric work draws on the wall paintings of her mother’s compound in Zaria.","imageId":"a3"}],"mediums":[{"id":"m1","name":"Oil on canvas","description":"Pigment bound in oil, worked in layers so colour sits over colour rather than mixing."},{"id":"m2","name":"Carved wood","description":"Cut from a single block, usually iroko, then smoked and oiled to darken and protect it."},{"id":"m3","name":"Screen print","description":"Ink pushed through a stencilled mesh, one colour at a time."},{"id":"m4","name":"Bronze","description":"Cast by the lost-wax method, a technique used in this region for over five hundred years."}],"locations":[{"id":"l1","name":"Main hall","floor":"Ground floor","imageId":"a1"},{"id":"l2","name":"East gallery","floor":"First floor","imageId":"a3"},{"id":"l3","name":"The courtyard","floor":"Ground floor","imageId":"a8"}],"pieces":[{"id":"p1","title":"Sunrise over the lagoon","artistId":"ar1","mediumId":"m1","locationId":"l1","year":"1974","description":"Painted from the jetty at Makoko over three mornings. The artist said she was chasing the ten minutes before the water turns from grey to gold.","classification":"Painting","department":"Painting & Sculpture","dimensions":"92 x 122 cm","fields":{"fd_support":"Oil on canvas, unlined"},"imageIds":["a1"],"audioBy":"the curator"},{"id":"p2","title":"Three peaks","artistId":"ar3","mediumId":"m3","locationId":"l2","year":"1981","description":"One of an edition of twelve. The orange was mixed to match the laterite of the road outside the studio.","classification":"Print","department":"Drawings & Prints","dimensions":"48 x 64 cm (sheet)","fields":{"fd_support":"Screenprint, 8 of 12"},"imageIds":["a2"],"audioBy":"the curator"},{"id":"p3","title":"Compound wall","artistId":"ar3","mediumId":"m3","locationId":"l2","year":"1979","description":"A direct quotation of the wall paintings in the artist’s mother’s compound, rebuilt as four flat squares.","classification":"Print","department":"Drawings & Prints","dimensions":"56 x 56 cm (sheet)","fields":{"fd_support":"Screenprint, 3 of 12"},"imageIds":["a3"],"audioBy":"the curator"},{"id":"p4","title":"Ceremonial mask","artistId":"ar2","mediumId":"m2","locationId":"l3","year":"1904","description":"Carved for the harvest festival and worn by the eldest son of the compound. Acquired in 1961 and unworn since.","classification":"Sculpture","department":"Painting & Sculpture","dimensions":"38 cm high","fields":{"fd_support":"Carved wood, pigment"},"imageIds":["a4"],"audioBy":"the curator"},{"id":"p5","title":"Two towers","artistId":"ar1","mediumId":"m1","locationId":"l1","year":"1988","description":"The last painting before the artist left for Dakar. The sun was added a year later, on her return.","classification":"Painting","department":"Painting & Sculpture","dimensions":"110 x 140 cm","fields":{"fd_support":"Oil on board"},"imageIds":["a5"],"audioBy":"the curator"},{"id":"p6","title":"Eclipse","artistId":"ar1","mediumId":"m1","locationId":"l2","year":"1992","description":"Two discs, one passing behind the other. The artist painted it the week of the eclipse and never exhibited it in her lifetime.","classification":"Painting","department":"Painting & Sculpture","dimensions":"80 x 80 cm","fields":{"fd_support":"Oil on canvas"},"imageIds":["a6"],"audioBy":"the curator"},{"id":"p7","title":"The new wing","artistId":"ar3","mediumId":"m3","locationId":"l1","year":"2003","description":"A print made to mark the opening of the east wing, showing the building as the architect first drew it.","classification":"Print","department":"Drawings & Prints","dimensions":"42 x 60 cm (sheet)","fields":{"fd_support":"Lithograph, 22 of 60"},"imageIds":["a7"],"audioBy":"the curator"},{"id":"p8","title":"Standing figure","artistId":"ar2","mediumId":"m4","locationId":"l3","year":"1966","description":"Cast in a single pour. The vertical line down the front is the seam of the mould, left deliberately unpolished.","classification":"Sculpture","department":"Painting & Sculpture","dimensions":"164 cm high","fields":{"fd_support":"Cast bronze, unpatinated"},"imageIds":["a8"],"audioBy":"the curator"},{"id":"p9","title":"Crossing","artistId":"ar2","mediumId":"m4","locationId":"l1","year":"1971","description":"Made for the roundabout at the old bridge, where it stood until 1998. The centre disc turns in high wind.","classification":"Sculpture","department":"Painting & Sculpture","dimensions":"210 cm high","fields":{"fd_support":"Welded steel, painted"},"imageIds":["a9"],"audioBy":"the curator"}],"images":{"a1":"data:image/svg+xml;base64,","a2":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA2MDAgNjAwIj48cmVjdCB3aWR0aD0iN